# 生产环境配置示例
# 复制这个文件为 .env.production 并填入正确的值

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=en_study

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT密钥
JWT_SECRET=your-super-secret-jwt-key-here

# 豆包API配置 (推荐用于图片识别)
DOUBAO_API_KEY=c11184cb-88c9-41d6-b7b2-697f19bf037b
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# DeepSeek API配置 (备用选择)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 有道翻译API配置 (可选，用于更准确的音标和翻译)
YOUDAO_APP_KEY=727970ee1dd6dabd
YOUDAO_APP_SECRET=6Ncwka7P7wJ4xr4QqO2MZ1k8nF4L2iGC

# 阿里云OSS配置
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET=your-bucket-name

# Swagger文档认证配置
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=admin123

# 服务配置
PORT=3000
NODE_ENV=production

# 如何获取API密钥：
# 
# 1. 豆包API：
#    - 访问：https://www.volcengine.com/product/doubao
#    - 注册并创建应用
#    - 获取API Key
#
# 2. DeepSeek API：
#    - 访问：https://platform.deepseek.com/
#    - 注册并获取API Key
#
# 3. 有道翻译API：
#    - 访问：https://ai.youdao.com/
#    - 注册智云账号
#    - 创建应用获取APP Key和Secret
#
# 4. 阿里云OSS：
#    - 访问：https://www.aliyun.com/product/oss
#    - 注册阿里云账号
#    - 创建AccessKey和Bucket